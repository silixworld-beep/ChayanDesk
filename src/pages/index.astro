---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JobTable from '../components/JobTable.astro';
import Badge from '../components/Badge.astro';
import AdSlot from '../components/AdSlot.astro';
import {
  SALARY_TIERS,
  SITE_CONFIG,
} from '../config/site';
import {
  type AdmissionEntry,
  type JobEntry,
  formatDisplayDate,
  formatVacancies,
  getDeadlineBadge,
  getJurisdictionSummary,
  getQualificationFacets,
  getSalaryTierFacets,
  getStateFacets,
  isJobActive,
  isJobClosingSoon,
  orderJobsLowExperienceFirst,
  parseCalendarDateUtc,
  sortJobsByDeadlineAsc,
  sortJobsByPostedDesc,
} from '../lib/jobs';

const allJobs = await getCollection('jobs');
const activeJobs = orderJobsLowExperienceFirst(
  sortJobsByPostedDesc(allJobs.filter((job) => isJobActive(job))),
);
const closingSoonJobs = sortJobsByDeadlineAsc(
  allJobs.filter((job) => isJobClosingSoon(job, 7)),
);
const admissions = (await getCollection('admissions')).sort((a, b) =>
  (a.data.application_deadline ?? '9999-12-31').localeCompare(
    b.data.application_deadline ?? '9999-12-31',
  ),
);

type MenuCategory = 'result' | 'admit-card' | 'answer-key';
const MENU_FALLBACK_LABEL: Record<MenuCategory, string> = {
  result: 'Result Out',
  'admit-card': 'Admit Card',
  'answer-key': 'Answer Key',
};

interface MenuFeedItem {
  title: string;
  href: string;
  linkLabel: string;
  sortDate: string;
}

function getPostsForMenuCategory(
  jobs: JobEntry[],
  adms: AdmissionEntry[],
  category: MenuCategory,
): MenuFeedItem[] {
  const fromJobs: MenuFeedItem[] = jobs
    .filter(
      (job) =>
        (job.data.homepage_menus ?? []).includes(category) ||
        (job.data.important_links ?? []).some((link) => link.category === category),
    )
    .map((job) => {
      const matching = (job.data.important_links ?? []).filter((link) => link.category === category);
      const primary = matching[0];
      const sortDate = primary?.added_at ?? job.data.posted_date;
      return {
        title: job.data.title,
        href: `/jobs/${job.data.slug}`,
        linkLabel: primary?.label ?? MENU_FALLBACK_LABEL[category],
        sortDate,
      };
    });

  const fromAdms: MenuFeedItem[] = adms
    .filter(
      (adm) =>
        (adm.data.homepage_menus ?? []).includes(category) ||
        (adm.data.important_links ?? []).some((link) => link.category === category),
    )
    .map((adm) => {
      const matching = (adm.data.important_links ?? []).filter((link) => link.category === category);
      const primary = matching[0];
      const sortDate = primary?.added_at ?? adm.data.posted_date ?? '2026-11-26';
      return {
        title: adm.data.title,
        href: `/admissions/${adm.data.slug}`,
        linkLabel: primary?.label ?? MENU_FALLBACK_LABEL[category],
        sortDate,
      };
    });

  return [...fromJobs, ...fromAdms].sort(
    (a, b) => parseCalendarDateUtc(b.sortDate) - parseCalendarDateUtc(a.sortDate),
  );
}

const resultJobs = getPostsForMenuCategory(allJobs, admissions, 'result');
const admitCardJobs = getPostsForMenuCategory(allJobs, admissions, 'admit-card');
const answerKeyJobs = getPostsForMenuCategory(allJobs, admissions, 'answer-key');

const guides = (await getCollection('guides')).sort(
  (a, b) =>
    parseCalendarDateUtc(b.data.published_date) -
    parseCalendarDateUtc(a.data.published_date),
);

// Marquee Ticker: Latest tagged releases (Result / Admit Card / Answer Key) + Closing Soon jobs
const tickerDrops = [
  ...resultJobs.slice(0, 3).map((item) => ({
    tag: 'RESULT',
    tagType: 'crimson' as const,
    title: `${item.title} — ${item.linkLabel}`,
    href: item.href,
    date: item.sortDate,
  })),
  ...admitCardJobs.slice(0, 3).map((item) => ({
    tag: 'ADMIT CARD',
    tagType: 'crimson' as const,
    title: `${item.title} — ${item.linkLabel}`,
    href: item.href,
    date: item.sortDate,
  })),
  ...answerKeyJobs.slice(0, 3).map((item) => ({
    tag: 'ANSWER KEY',
    tagType: 'navy' as const,
    title: `${item.title} — ${item.linkLabel}`,
    href: item.href,
    date: item.sortDate,
  })),
  ...closingSoonJobs.slice(0, 6).map((j) => ({
    tag: 'CLOSING SOON',
    tagType: 'navy' as const,
    title: `${j.data.title} (Last Date: ${formatDisplayDate(j.data.application_deadline)})`,
    href: `/jobs/${j.data.slug}`,
    date: j.data.posted_date,
  })),
]
  .sort((a, b) => parseCalendarDateUtc(b.date) - parseCalendarDateUtc(a.date))
  .slice(0, 8);

const qualifications = getQualificationFacets(activeJobs);
const states = getStateFacets(activeJobs);
const salaryFacets = getSalaryTierFacets(allJobs);
const jurisdictionSummary = getJurisdictionSummary(activeJobs);

const savedManifest = activeJobs.map((j) => {
  const b = getDeadlineBadge(j.data.application_deadline);
  return {
    slug: j.data.slug,
    title: j.data.title,
    organization: j.data.organization,
    deadline: formatDisplayDate(j.data.application_deadline),
    badgeLabel: b.label,
    badgeVariant: b.variant,
    url: `/jobs/${j.data.slug}`,
  };
});

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_CONFIG.brandName,
  url: (Astro.site ?? new URL(SITE_CONFIG.siteUrl)).toString(),
  description: SITE_CONFIG.positioningTagline,
};
---

<BaseLayout
  title={`${SITE_CONFIG.brandName} — Verified Government & PSU Recruitment Portal`}
  description="Browse verified Central & State Government jobs, 7th CPC pay matrix scales, official notifications, admit cards, and government admissions."
  canonicalPath="/"
  jsonLd={websiteJsonLd}
>
  <!-- 1. Scrolling Notice Marquee (~38px compact editorial strip) -->
  <section
    aria-label="Latest Official Releases"
    class="bg-surface border border-border-strong rounded-[3px] px-3 py-2 mb-3 flex items-center gap-3 overflow-hidden"
  >
    <span class="font-mono text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 bg-urgent-bg text-urgent-text border border-urgent-border rounded-[3px] shrink-0">
      LATEST UPDATES
    </span>
    <div class="chayan-marquee-viewport">
      <div class="chayan-marquee-track">
        {
          [0, 1].map((copyIdx) => (
            <div
              class="flex items-center gap-5 shrink-0 pr-5 text-xs whitespace-nowrap"
              aria-hidden={copyIdx === 1 ? 'true' : undefined}
            >
              {tickerDrops.map((item) => {
                const isJobLink = item.href.startsWith('/jobs/');
                return (
                  <a
                    href={item.href}
                    target={isJobLink ? '_blank' : undefined}
                    rel={isJobLink ? 'noopener noreferrer' : undefined}
                    tabindex={copyIdx === 1 ? -1 : undefined}
                    class="inline-flex items-center gap-1.5 text-ink hover:text-navy no-underline transition-colors duration-150"
                  >
                    <span
                      class:list={[
                        'font-mono text-[10px] font-bold px-1.5 py-0.25 rounded-[3px] border',
                        item.tagType === 'crimson'
                          ? 'bg-urgent-bg text-urgent-text border-urgent-border'
                          : 'bg-canvas text-navy border-border',
                      ]}
                    >
                      [{item.tag}]
                    </span>
                    <span class="font-semibold hover:underline">{item.title}</span>
                  </a>
                );
              })}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 2. Identity Filter Dock (Compact single-band command bar — Authority removed) -->
  <section
    aria-label="Command Desk Job Filters"
    class="bg-surface border border-border-strong rounded-[3px] p-3 mb-2 space-y-2.5"
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-2 items-center">
      <div class="lg:col-span-4">
        <label for="job-search-input" class="sr-only">Search Jobs</label>
        <input
          id="job-search-input"
          type="search"
          placeholder="Search post, SSC CGL, UPSC, JEE, NEET, AIIMS..."
          class="w-full h-9 px-2.5 text-xs text-ink bg-canvas border border-border rounded-[3px] focus:outline-none focus:border-navy"
        />
      </div>

      <div class="lg:col-span-2">
        <label for="salary-filter" class="sr-only">Salary Scale</label>
        <select
          id="salary-filter"
          class="w-full h-9 px-2 text-xs font-medium text-ink bg-canvas border border-border rounded-[3px] focus:outline-none focus:border-navy"
        >
          <option value="all">Salary Scale: All</option>
          {
            SALARY_TIERS.map((t) => (
              <option value={t.slug}>{t.shortLabel}</option>
            ))
          }
          <option value="not-specified">Unspecified Scale</option>
        </select>
      </div>

      <div class="lg:col-span-3">
        <label for="qualification-filter" class="sr-only">Qualification</label>
        <select
          id="qualification-filter"
          class="w-full h-9 px-2 text-xs font-medium text-ink bg-canvas border border-border rounded-[3px] focus:outline-none focus:border-navy"
        >
          <option value="all">Qualification: All</option>
          {
            qualifications.map((q) => (
              <option value={q.slug}>
                {q.name} ({q.activeCount})
              </option>
            ))
          }
        </select>
      </div>

      <div class="lg:col-span-2">
        <label for="jurisdiction-filter" class="sr-only">State or Central</label>
        <select
          id="jurisdiction-filter"
          class="w-full h-9 px-2 text-xs font-medium text-ink bg-canvas border border-border rounded-[3px] focus:outline-none focus:border-navy"
        >
          <option value="all">State / Central: All</option>
          <option value="level:central">Central Govt ({jurisdictionSummary.centralActive})</option>
          <option value="level:state">All State Govts ({jurisdictionSummary.stateActive})</option>
          {
            states.map((st) => (
              <option value={`state:${st.slug}`}>
                {st.name} ({st.activeCount})
              </option>
            ))
          }
        </select>
      </div>

      <div class="lg:col-span-1 flex justify-end">
        <button
          id="reset-filters-btn"
          type="button"
          class="w-full h-9 px-2.5 text-xs font-semibold text-ink-secondary bg-canvas border border-border rounded-[3px] hover:bg-surface hover:text-navy hover:border-navy transition-colors duration-150 cursor-pointer"
        >
          Reset
        </button>
      </div>
    </div>

    <!-- Most-Clicked Exam & Qualification Filters -->
    <div class="pt-2 border-t border-border">
      <div id="quick-filter-pills" class="flex flex-wrap items-center gap-1.5">
        <button type="button" data-quick="all" class="q-pill px-2.5 py-1 text-[11px] font-semibold bg-navy text-white border border-navy hover:bg-navy-hover hover:text-white rounded-[3px] transition-colors duration-150 cursor-pointer">
          All
        </button>
        <button type="button" data-quick="kw:ssc|cgl|chsl|mts|staff selection" class="q-pill px-2.5 py-1 text-[11px] font-semibold bg-canvas text-ink border border-border hover:bg-navy/5 hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer">
          SSC CGL / CHSL
        </button>
        <button type="button" data-quick="kw:upsc|civil services|ias|ies|nda|cds" class="q-pill px-2.5 py-1 text-[11px] font-semibold bg-canvas text-ink border border-border hover:bg-navy/5 hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer">
          UPSC
        </button>
        <button type="button" data-quick="kw:railway|rrb|dfccil|loco" class="q-pill px-2.5 py-1 text-[11px] font-semibold bg-canvas text-ink border border-border hover:bg-navy/5 hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer">
          Railway / RRB
        </button>
        <button type="button" data-quick="kw:bank|ibps|sbi|rbi|sidbi|sebi|nabard" class="q-pill px-2.5 py-1 text-[11px] font-semibold bg-canvas text-ink border border-border hover:bg-navy/5 hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer">
          Banking / IBPS
        </button>
        <button type="button" data-quick="kw:police|defence|defense|army|ordnance|weapons|tribunal" class="q-pill px-2.5 py-1 text-[11px] font-semibold bg-canvas text-ink border border-border hover:bg-navy/5 hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer">
          Police / Defence
        </button>
        <button type="button" data-quick="kw:jee|joint entrance|jeecup" data-prefer-stream="admissions" class="q-pill px-2.5 py-1 text-[11px] font-semibold bg-canvas text-ink border border-border hover:bg-navy/5 hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer">
          JEE
        </button>
        <button type="button" data-quick="kw:neet|medical entrance" data-prefer-stream="admissions" class="q-pill px-2.5 py-1 text-[11px] font-semibold bg-canvas text-ink border border-border hover:bg-navy/5 hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer">
          NEET
        </button>
        <button type="button" data-quick="kw:cuet" data-prefer-stream="admissions" class="q-pill px-2.5 py-1 text-[11px] font-semibold bg-canvas text-ink border border-border hover:bg-navy/5 hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer">
          CUET
        </button>
        <button type="button" data-quick="qualgroup:10-12" class="q-pill px-2.5 py-1 text-[11px] font-semibold bg-canvas text-ink border border-border hover:bg-navy/5 hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer">
          10th / 12th Pass
        </button>
        <button type="button" data-quick="qual:graduate" class="q-pill px-2.5 py-1 text-[11px] font-semibold bg-canvas text-ink border border-border hover:bg-navy/5 hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer">
          Graduate
        </button>
      </div>
    </div>
  </section>

  <!-- 3. Ad Slot 1 (Leaderboard) -->
  <AdSlot variant="leaderboard" />

  <!-- 4. Primary Dual-Intent Workspace (68% Left / 32% Right) -->
  <div class="grid grid-cols-1 lg:grid-cols-[68fr_32fr] gap-5 items-start mt-2">
    <!-- Left (68%): Master Recruitment Stream -->
    <section aria-label="Master Recruitment Stream" class="min-w-0 space-y-3">
      <div class="bg-surface border border-border-strong rounded-[3px] px-3 py-2 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-1.5" role="tablist" aria-label="Recruitment Stream Tabs">
          <button
            id="stream-tab-jobs"
            type="button"
            role="tab"
            aria-selected="true"
            class="stream-tab px-3 py-1.5 text-xs font-bold bg-navy text-white border border-navy hover:bg-navy-hover hover:text-white rounded-[3px] transition-colors duration-150 cursor-pointer"
          >
            Latest Jobs ({activeJobs.length})
          </button>
          <button
            id="stream-tab-closing"
            type="button"
            role="tab"
            aria-selected="false"
            class="stream-tab px-3 py-1.5 text-xs font-semibold bg-canvas text-ink-secondary border border-border hover:bg-surface hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer tabular-nums"
          >
            Closing in 7 Days ({closingSoonJobs.length})
          </button>
          <button
            id="stream-tab-admissions"
            type="button"
            role="tab"
            aria-selected="false"
            class="stream-tab px-3 py-1.5 text-xs font-semibold bg-canvas text-ink-secondary border border-border hover:bg-surface hover:text-navy hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer tabular-nums"
          >
            Admissions ({admissions.length})
          </button>
        </div>

        <div class="flex items-center gap-2.5 ml-auto">
          <span
            id="visible-count-label"
            class="font-mono text-[11px] text-ink-secondary tabular-nums"
          >
            Showing {Math.min(18, activeJobs.length)} of {activeJobs.length}
          </span>
          <label for="job-sort-select" class="sr-only">Sort Jobs</label>
          <select
            id="job-sort-select"
            class="h-8 px-2 text-xs font-medium text-ink bg-canvas border border-border rounded-[3px] hover:border-navy focus:outline-none focus:border-navy transition-colors duration-150"
          >
            <option value="newest">Sort: Newest Verified</option>
            <option value="salary">Sort: Highest Salary First</option>
            <option value="closing">Sort: Closing Soonest</option>
            <option value="vacancies">Sort: Most Vacancies</option>
          </select>
        </div>
      </div>

      <!-- Jobs Stream Panel -->
      <div id="jobs-stream-panel" class="space-y-3">
        <JobTable
          jobs={activeJobs}
          tableId="homepage-jobs-table"
          enableFilterTargets={true}
          defaultHiddenAfter={18}
          injectInFeedAdAfterIndex={5}
          openInNewTab={true}
          emptyMessage="No verified government jobs match your current filter selection."
        />

        <div class="bg-surface border border-border-strong rounded-[3px] px-3.5 py-2.5 flex flex-wrap items-center justify-between gap-2 text-xs">
          <button
            id="show-all-stream-btn"
            type="button"
            class="px-3 py-1.5 font-semibold bg-canvas text-navy border border-border hover:bg-navy hover:text-white hover:border-navy rounded-[3px] transition-colors duration-150 cursor-pointer"
          >
            Show All {activeJobs.length} Active Openings
          </button>
          <a href="/jobs" class="font-bold text-accent hover:underline">
            View Full Jobs Archive &rarr;
          </a>
        </div>
      </div>

      <!-- Admissions Stream Panel (shown when Admissions tab or Admission quick filter is active) -->
      <div id="admissions-stream-panel" class="hidden space-y-3">
        <div class="bg-surface border border-border-strong rounded-[3px] divide-y divide-border">
          {
            admissions.map((item) => {
              const admSearch = [item.data.title, item.data.organization, item.data.course_level, item.data.location, item.data.source_domain].join(' ').toLowerCase();
              return (
                <article
                  data-adm-row="true"
                  data-search={admSearch}
                  class="p-3.5 hover:bg-canvas/70 flex flex-col sm:flex-row sm:items-center justify-between gap-3"
                >
                  <div class="min-w-0 space-y-1">
                    <div class="flex flex-wrap items-center gap-2 text-[11px]">
                      <span class="px-1.5 py-0.25 bg-canvas border border-border rounded-[3px] font-semibold text-navy">
                        {item.data.course_level}
                      </span>
                      <span class="font-mono text-ink-secondary">{item.data.source_domain}</span>
                    </div>
                    <h3 class="text-sm font-bold m-0">
                      <a href={`/admissions/${item.data.slug}`} class="notice-link hover:underline">
                        {item.data.title}
                      </a>
                    </h3>
                    <div class="text-xs text-ink-secondary">
                      {item.data.organization} &middot; {item.data.location}
                    </div>
                  </div>
                  <div class="flex items-center gap-3 shrink-0">
                    <div class="text-right">
                      <span class="block font-mono text-[10px] text-ink-secondary uppercase">Last Date</span>
                      <span class="font-mono text-xs font-bold text-ink tabular-nums">
                        {formatDisplayDate(item.data.application_deadline)}
                      </span>
                    </div>
                    <a
                      href={`/admissions/${item.data.slug}`}
                      class="px-3 py-1.5 text-xs font-semibold bg-navy text-white rounded-[3px] no-underline hover:bg-navy-hover whitespace-nowrap"
                    >
                      Details &rarr;
                    </a>
                  </div>
                </article>
              );
            })
          }
          <div id="admissions-empty-state" class="hidden px-4 py-8 text-center text-xs text-ink-secondary">
            No matching active entrance or admission notices found for this filter.
          </div>
        </div>
        <div class="text-right text-xs">
          <a href="/admissions" class="font-bold text-accent hover:underline">
            View All Government Admissions &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Right (32%): Live Action Rail -->
    <aside aria-label="Live Action Rail" class="space-y-4">
      <!-- Module 1: ChayanDesk Updates Desk (Result | Admit Card | Answer Key — linked to Job Pages) -->
      <div class="bg-surface border border-border-strong rounded-[3px] overflow-hidden">
        <div class="bg-canvas border-b border-border-strong px-2.5 pt-2.5 pb-0 flex items-center justify-between">
          <div class="flex items-center gap-1" role="tablist" aria-label="Official Exam Desk Tabs">
            <button
              type="button"
              data-rail-tab="result"
              class="rail-tab px-2.5 py-1.5 text-xs font-bold bg-navy text-white border border-b-0 border-navy hover:bg-navy-hover hover:text-white rounded-t-[3px] transition-colors duration-150 cursor-pointer"
            >
              Result
            </button>
            <button
              type="button"
              data-rail-tab="admit-card"
              class="rail-tab px-2.5 py-1.5 text-xs font-semibold bg-transparent text-ink-secondary border border-b-0 border-transparent hover:bg-surface hover:text-navy hover:border-border rounded-t-[3px] transition-colors duration-150 cursor-pointer"
            >
              Admit Card
            </button>
            <button
              type="button"
              data-rail-tab="answer-key"
              class="rail-tab px-2.5 py-1.5 text-xs font-semibold bg-transparent text-ink-secondary border border-b-0 border-transparent hover:bg-surface hover:text-navy hover:border-border rounded-t-[3px] transition-colors duration-150 cursor-pointer"
            >
              Answer Key
            </button>
          </div>
        </div>

        <div id="rail-panel-result" class="rail-panel divide-y divide-border">
          {
            resultJobs.length > 0 ? (
              resultJobs.slice(0, 8).map((item) => (
                <a
                  href={item.href}
                  target={item.href.startsWith('/jobs/') ? '_blank' : undefined}
                  rel={item.href.startsWith('/jobs/') ? 'noopener noreferrer' : undefined}
                  class="px-3 py-2.5 block hover:bg-canvas no-underline space-y-0.5 transition-colors duration-150"
                >
                  <div class="flex items-center justify-between gap-2 text-[11px]">
                    <span class="font-mono text-ink-secondary tabular-nums">
                      {formatDisplayDate(item.sortDate)}
                    </span>
                    <span class="font-mono text-[10px] font-bold px-1.5 py-0 bg-urgent-bg text-urgent-text border border-urgent-border rounded-[3px] truncate max-w-[140px]">
                      {item.linkLabel}
                    </span>
                  </div>
                  <div class="text-xs font-semibold notice-link leading-snug">
                    {item.title}
                  </div>
                </a>
              ))
            ) : (
              <div class="px-3.5 py-4 text-xs text-ink-secondary">
                No official result links attached yet. Notices posted to Result appear here automatically.
              </div>
            )
          }
          <div class="px-3 py-2 bg-canvas text-right">
            <a href="/jobs" class="text-xs font-bold text-accent hover:underline">
              Browse All Recruitment Posts &rarr;
            </a>
          </div>
        </div>

        <div id="rail-panel-admit-card" class="rail-panel hidden divide-y divide-border">
          {
            admitCardJobs.length > 0 ? (
              admitCardJobs.slice(0, 8).map((item) => (
                <a
                  href={item.href}
                  target={item.href.startsWith('/jobs/') ? '_blank' : undefined}
