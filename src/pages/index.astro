  <script id="homepage-saved-manifest" type="application/json" set:html={JSON.stringify(savedManifest)} />

  <script is:inline>
    (function () {
      const searchInput = document.getElementById('job-search-input');
      const salarySelect = document.getElementById('salary-filter');
      const qualSelect = document.getElementById('qualification-filter');
      const jurSelect = document.getElementById('jurisdiction-filter');
      const sortSelect = document.getElementById('job-sort-select');
      const resetBtn = document.getElementById('reset-filters-btn');
      const showAllBtn = document.getElementById('show-all-stream-btn');
      const countLabel = document.getElementById('visible-count-label');
      const emptyState = document.getElementById('filter-empty-state');
      const admEmptyState = document.getElementById('admissions-empty-state');
      const tableEl = document.getElementById('homepage-jobs-table');

      const tabJobsBtn = document.getElementById('stream-tab-jobs');
      const tabClosingBtn = document.getElementById('stream-tab-closing');
      const tabAdmBtn = document.getElementById('stream-tab-admissions');
      const jobsPanel = document.getElementById('jobs-stream-panel');
      const admPanel = document.getElementById('admissions-stream-panel');

      const quickButtons = Array.from(document.querySelectorAll('#quick-filter-pills .q-pill'));
      const railButtons = Array.from(document.querySelectorAll('[data-rail-tab]'));
      const railPanels = Array.from(document.querySelectorAll('.rail-panel'));

      const rows = Array.from(document.querySelectorAll('#homepage-jobs-table [data-job-row="true"]'));
      const admRows = Array.from(document.querySelectorAll('#admissions-stream-panel [data-adm-row="true"]'));
      const inFeedAdWrapper = tableEl
        ? Array.from(tableEl.children).find((el) => el.querySelector('[data-ad-variant="in-feed"]')) || null
        : null;

      let activeStreamMode = 'jobs'; // 'jobs' | 'closing' | 'admissions'
      let activeQuick = 'all';
      let showAllStream = false;

      function syncQuickPillStyles() {
        for (const btn of quickButtons) {
          const isAct = (btn.getAttribute('data-quick') || 'all') === activeQuick;
          btn.classList.toggle('bg-navy', isAct);
          btn.classList.toggle('text-white', isAct);
          btn.classList.toggle('border-navy', isAct);
          btn.classList.toggle('hover:bg-navy-hover', isAct);
          btn.classList.toggle('hover:text-white', isAct);
          btn.classList.toggle('bg-canvas', !isAct);
          btn.classList.toggle('text-ink', !isAct);
          btn.classList.toggle('border-border', !isAct);
          btn.classList.toggle('hover:bg-navy/5', !isAct);
          btn.classList.toggle('hover:text-navy', !isAct);
          btn.classList.toggle('hover:border-navy', !isAct);
        }
      }

      function matchesQuickTerms(searchText) {
        if (!activeQuick.startsWith('kw:')) return true;
        const terms = activeQuick.slice(3).split('|').map((t) => t.trim()).filter(Boolean);
        return terms.some((term) => searchText.includes(term));
      }

      function sortRowsDom() {
        if (!tableEl || !sortSelect) return;
        const mode = sortSelect.value || 'newest';
        const sorted = [...rows].sort((a, b) => {
          if (mode === 'salary') {
            return Number(b.getAttribute('data-salary-val') || 0) - Number(a.getAttribute('data-salary-val') || 0);
          }
          if (mode === 'closing') {
            return String(a.getAttribute('data-deadline') || '9999-12-31').localeCompare(
              String(b.getAttribute('data-deadline') || '9999-12-31'),
            );
          }
          if (mode === 'vacancies') {
            return Number(b.getAttribute('data-vacancies') || 0) - Number(a.getAttribute('data-vacancies') || 0);
          }
          return (
            Number(a.getAttribute('data-initial-order') || 0) -
            Number(b.getAttribute('data-initial-order') || 0)
          );
        });

        for (const r of sorted) {
          tableEl.appendChild(r);
        }
        if (emptyState) tableEl.appendChild(emptyState);
      }

      function repositionInFeedAd(visibleRows) {
        if (!tableEl || !inFeedAdWrapper) return;
        if (visibleRows.length >= 5) {
          visibleRows[4].insertAdjacentElement('afterend', inFeedAdWrapper);
          inFeedAdWrapper.classList.remove('hidden');
        } else {
          inFeedAdWrapper.classList.add('hidden');
        }
      }

      function applyAdmissionsFilter() {
        const query = (searchInput && searchInput.value ? searchInput.value : '').trim().toLowerCase();
        let shown = 0;
        for (const row of admRows) {
          const rSearch = row.getAttribute('data-search') || '';
          let ok = true;
          if (query && !rSearch.includes(query)) ok = false;
          if (ok && activeQuick.startsWith('kw:') && !matchesQuickTerms(rSearch)) ok = false;
          row.classList.toggle('hidden', !ok);
          if (ok) shown += 1;
        }
        if (admEmptyState) admEmptyState.classList.toggle('hidden', shown > 0);
        if (countLabel && activeStreamMode === 'admissions') {
          countLabel.textContent = `Showing ${shown} of ${admRows.length} Admissions`;
        }
      }

      function applyFilters() {
        if (activeStreamMode === 'admissions') {
          applyAdmissionsFilter();
          return;
        }

        const query = (searchInput && searchInput.value ? searchInput.value : '').trim().toLowerCase();
        const sal = salarySelect ? salarySelect.value : 'all';
        const qual = qualSelect ? qualSelect.value : 'all';
        const jur = jurSelect ? jurSelect.value : 'all';

        const anyFilterActive =
          Boolean(query) ||
          sal !== 'all' ||
          qual !== 'all' ||
          jur !== 'all' ||
          activeQuick !== 'all' ||
          activeStreamMode === 'closing';

        const orderedRows = Array.from(
          document.querySelectorAll('#homepage-jobs-table [data-job-row="true"]'),
        );
        const matchedRows = [];

        for (const row of orderedRows) {
          const rSearch = row.getAttribute('data-search') || '';
          const rSal = row.getAttribute('data-salary-tier') || '';
          const rQual = row.getAttribute('data-qualification') || '';
          const rLevel = row.getAttribute('data-government-level') || '';
          const rState = row.getAttribute('data-state') || '';
          const rClosing = row.getAttribute('data-closing-soon') === 'true';

          let ok = true;
          if (activeStreamMode === 'closing' && !rClosing) ok = false;
          if (ok && query && !rSearch.includes(query)) ok = false;
          if (ok && sal !== 'all' && rSal !== sal) ok = false;
          if (ok && qual !== 'all' && rQual !== qual) ok = false;

          if (ok && jur !== 'all') {
            if (jur.startsWith('level:')) {
              ok = rLevel === jur.slice(6);
            } else if (jur.startsWith('state:')) {
              ok = rState === jur.slice(6);
            }
          }

          if (ok && activeQuick === 'qualgroup:10-12') {
            ok = rQual === '10th-pass' || rQual === '12th-pass' || rQual === 'diploma-iti';
          } else if (ok && activeQuick.startsWith('kw:')) {
            ok = matchesQuickTerms(rSearch);
          }

          if (ok) matchedRows.push(row);
          row.classList.add('hidden');
        }

        const cap = showAllStream || anyFilterActive ? matchedRows.length : 18;
        const visibleRows = matchedRows.slice(0, cap);
        for (const r of visibleRows) {
          r.classList.remove('hidden');
        }

        repositionInFeedAd(visibleRows);

        if (countLabel) {
          countLabel.textContent = `Showing ${visibleRows.length} of ${matchedRows.length}`;
        }
        if (emptyState) {
          emptyState.classList.toggle('hidden', matchedRows.length > 0);
        }
        if (showAllBtn) {
          showAllBtn.classList.toggle('hidden', showAllStream || anyFilterActive || matchedRows.length <= 18);
        }
      }

      // Most-Clicked Quick Pills Click
      for (const btn of quickButtons) {
        btn.addEventListener('click', function () {
          const val = btn.getAttribute('data-quick') || 'all';
          const preferStream = btn.getAttribute('data-prefer-stream');
          activeQuick = val;
          if (val === 'all') {
            if (salarySelect) salarySelect.value = 'all';
            if (qualSelect) qualSelect.value = 'all';
            if (jurSelect) jurSelect.value = 'all';
            setStreamMode('jobs');
          } else if (val.startsWith('qual:')) {
            if (qualSelect) qualSelect.value = val.slice(5);
            if (activeStreamMode === 'admissions') setStreamMode('jobs');
          } else if (preferStream === 'admissions') {
            setStreamMode('admissions');
          } else if (activeStreamMode === 'admissions') {
            setStreamMode('jobs');
          }
          syncQuickPillStyles();
          applyFilters();
        });
      }

      // Filter & Sort Listeners
      if (searchInput) searchInput.addEventListener('input', applyFilters);
      if (salarySelect) {
        salarySelect.addEventListener('change', function () {
          syncQuickPillStyles();
          applyFilters();
        });
      }
      if (qualSelect) {
        qualSelect.addEventListener('change', function () {
          if (activeQuick.startsWith('qualgroup:') || activeQuick.startsWith('qual:')) activeQuick = 'all';
          syncQuickPillStyles();
          applyFilters();
        });
      }
      if (jurSelect) {
        jurSelect.addEventListener('change', function () {
          applyFilters();
        });
      }
      if (sortSelect) {
        sortSelect.addEventListener('change', function () {
          sortRowsDom();
          applyFilters();
        });
      }
      if (showAllBtn) {
        showAllBtn.addEventListener('click', function () {
          showAllStream = true;
          applyFilters();
        });
      }
      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          activeQuick = 'all';
          showAllStream = false;
          if (searchInput) searchInput.value = '';
          if (salarySelect) salarySelect.value = 'all';
          if (qualSelect) qualSelect.value = 'all';
          if (jurSelect) jurSelect.value = 'all';
          if (sortSelect) {
            sortSelect.value = 'newest';
            sortRowsDom();
          }
          setStreamMode('jobs');
          syncQuickPillStyles();
          applyFilters();
        });
      }

      // Main Stream Tabs (Latest Jobs | Closing Soon | Admissions)
      function setStreamMode(mode) {
        activeStreamMode = mode;
        const buttons = [
          { el: tabJobsBtn, id: 'jobs' },
          { el: tabClosingBtn, id: 'closing' },
          { el: tabAdmBtn, id: 'admissions' },
        ];
        for (const item of buttons) {
          if (!item.el) continue;
          const act = item.id === mode;
          item.el.setAttribute('aria-selected', act ? 'true' : 'false');
          item.el.classList.toggle('bg-navy', act);
          item.el.classList.toggle('text-white', act);
          item.el.classList.toggle('border-navy', act);
          item.el.classList.toggle('font-bold', act);
          item.el.classList.toggle('hover:bg-navy-hover', act);
          item.el.classList.toggle('hover:text-white', act);
          item.el.classList.toggle('bg-canvas', !act);
          item.el.classList.toggle('text-ink-secondary', !act);
          item.el.classList.toggle('border-border', !act);
          item.el.classList.toggle('font-semibold', !act);
          item.el.classList.toggle('hover:bg-surface', !act);
          item.el.classList.toggle('hover:text-navy', !act);
          item.el.classList.toggle('hover:border-navy', !act);
        }
        if (jobsPanel) jobsPanel.classList.toggle('hidden', mode === 'admissions');
        if (admPanel) admPanel.classList.toggle('hidden', mode !== 'admissions');
        if (sortSelect) sortSelect.classList.toggle('hidden', mode === 'admissions');
        applyFilters();
      }

      if (tabJobsBtn) tabJobsBtn.addEventListener('click', () => setStreamMode('jobs'));
      if (tabClosingBtn) tabClosingBtn.addEventListener('click', () => setStreamMode('closing'));
      if (tabAdmBtn) tabAdmBtn.addEventListener('click', () => setStreamMode('admissions'));

      // Live Action Rail Exam Desk Tabs (Result | Admit Card | Answer Key)
      for (const btn of railButtons) {
        btn.addEventListener('click', function () {
          const target = btn.getAttribute('data-rail-tab');
          for (const b of railButtons) {
            const act = b === btn;
            b.classList.toggle('bg-navy', act);
            b.classList.toggle('text-white', act);
            b.classList.toggle('font-bold', act);
            b.classList.toggle('border-navy', act);
            b.classList.toggle('hover:bg-navy-hover', act);
            b.classList.toggle('hover:text-white', act);
            b.classList.toggle('bg-transparent', !act);
            b.classList.toggle('text-ink-secondary', !act);
            b.classList.toggle('font-semibold', !act);
            b.classList.toggle('border-transparent', !act);
            b.classList.toggle('hover:bg-surface', !act);
            b.classList.toggle('hover:text-navy', !act);
            b.classList.toggle('hover:border-border', !act);
          }
          for (const p of railPanels) {
            p.classList.toggle('hidden', p.id !== `rail-panel-${target}`);
          }
        });
      }

      // Live Action Rail Saved Exams Widget
      const savedManifestEl = document.getElementById('homepage-saved-manifest');
      const railSavedList = document.getElementById('rail-saved-list');
      let savedLookup = {};
      try {
        const parsed = JSON.parse((savedManifestEl && savedManifestEl.textContent) || '[]');
        for (const item of parsed) savedLookup[item.slug] = item;
      } catch (_) {}

      function escHtml(v) {
        return String(v ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function renderRailSaved() {
        if (!railSavedList || typeof window.__chayanGetSaved !== 'function') return;
        const slugs = window.__chayanGetSaved();
        const items = slugs.map((s) => savedLookup[s]).filter(Boolean).slice(0, 5);
        if (items.length === 0) {
          railSavedList.innerHTML =
            '<div class="px-3.5 py-3 text-ink-secondary">Tap the bookmark icon on any job to pin deadlines here.</div>';
          return;
        }
        railSavedList.innerHTML = items
          .map(
            (item) => `
            <a href="${escHtml(item.url)}" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2.5 block hover:bg-canvas no-underline space-y-0.5 transition-colors duration-150">
              <div class="flex items-center justify-between gap-2 text-[11px]">
                <span class="font-mono text-ink-secondary tabular-nums">${escHtml(item.deadline)}</span>
                <span class="font-mono text-[10px] font-semibold ${item.badgeVariant === 'urgent' ? 'text-urgent-text' : 'text-active-text'}">${escHtml(item.badgeLabel)}</span>
              </div>
              <div class="text-xs font-semibold notice-link leading-snug">${escHtml(item.title)}</div>
            </a>
          `,
          )
          .join('');
      }

      window.addEventListener('chayandesk:saved-updated', renderRailSaved);

      // Initialize
      syncQuickPillStyles();
      applyFilters();
      renderRailSaved();
    })();
  </script>
</BaseLayout>
