---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { formatDisplayDate } from '../../lib/jobs';

const admissions = (await getCollection('admissions')).sort((a, b) =>
  (a.data.application_deadline ?? '9999-12-31').localeCompare(
    b.data.application_deadline ?? '9999-12-31',
  ),
);
---

<BaseLayout
  title="Government University, Polytechnic & Entrance Admissions"
  description="CUET UG/PG, Polytechnic Diploma, State B.Ed., Navodaya JNVST, and ICAR government institution admission notices with fee tables and deadlines."
  canonicalPath="/admissions"
>
  <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ink-secondary">
    <ol class="flex items-center gap-1.5">
      <li><a href="/" class="hover:text-navy hover:underline">Home</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink font-medium">Admissions</li>
    </ol>
  </nav>

  <header class="bg-surface border border-border-strong rounded-[3px] p-4 mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-navy tracking-tight">
        Government University &amp; Entrance Admissions
      </h1>
      <p class="text-xs text-ink-secondary mt-1">
        Central Universities (CUET), State Polytechnic, B.Ed., Agriculture, and Navodaya residential admissions.
      </p>
    </div>
    <span class="font-mono text-xs px-2.5 py-1 bg-canvas border border-border rounded-[3px] text-ink tabular-nums self-start sm:self-center">
      {admissions.length} Active Entrances
    </span>
  </header>

  <AdSlot variant="leaderboard" />

  <div class="grid grid-cols-1 lg:grid-cols-[68fr_32fr] gap-5 items-start mt-4">
    <section aria-label="Admissions List" class="bg-surface border border-border-strong rounded-[3px] divide-y divide-border">
      {
        admissions.length > 0 ? (
          admissions.map((item) => (
            <article class="p-3.5 hover:bg-canvas/70 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="min-w-0 space-y-1">
                <div class="flex flex-wrap items-center gap-2 text-[11px]">
                  <span class="px-1.5 py-0.25 bg-canvas border border-border rounded-[3px] font-semibold text-navy">
                    {item.data.course_level}
                  </span>
                  <span class="font-mono text-ink-secondary">{item.data.source_domain}</span>
                </div>
                <h2 class="text-sm font-bold leading-snug m-0">
                  <a href={`/admissions/${item.data.slug}`} class="notice-link hover:underline">
                    {item.data.title}
                  </a>
                </h2>
                <div class="text-xs text-ink-secondary">
                  {item.data.organization} &middot; {item.data.location}
                </div>
                {item.data.application_fee && (
                  <div class="font-mono text-[11px] text-ink-secondary">
                    Fee: {item.data.application_fee}
                  </div>
                )}
              </div>
              <div class="flex sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0">
                <div class="text-right">
                  <span class="block text-[10px] uppercase font-mono text-ink-secondary">Deadline</span>
                  <span class="font-mono text-xs font-bold text-ink tabular-nums">
                    {formatDisplayDate(item.data.application_deadline)}
                  </span>
                </div>
                <a
                  href={`/admissions/${item.data.slug}`}
                  class="px-3 py-1.5 text-xs font-semibold bg-navy hover:bg-navy-hover text-white rounded-[3px] no-underline whitespace-nowrap"
                >
                  Apply &amp; Brochure &rarr;
                </a>
              </div>
            </article>
          ))
        ) : (
          <div class="p-8 text-center text-xs text-ink-secondary space-y-2">
            <div class="text-sm font-bold text-ink">No active admission notices published yet</div>
            <p class="m-0">
              Verified university, NTA, polytechnic, and counselling notifications collected from the <strong>Admission</strong> target source appear here automatically.
            </p>
          </div>
        )
      }
    </section>

    <aside class="space-y-4">
      <div class="bg-surface border border-border-strong rounded-[3px] p-3.5 space-y-2 text-xs">
        <h2 class="text-xs font-bold uppercase tracking-wider text-navy m-0">
          Direct Admission Portals
        </h2>
        <p class="text-ink-secondary m-0 leading-relaxed">
          All links route strictly to official conducting authorities including NTA, CLAT Consortium, JoSAA, AIIMS, DU, AMU, JMI, IGNOU, JEECUP, MAHA-CET, WBJEEB, BCECEB, and KEA.
        </p>
        <div class="pt-1 flex flex-col gap-1.5">
          <a href="/jobs" class="font-semibold text-accent hover:underline">Explore Active Govt Jobs &rarr;</a>
          <a href="/guides" class="font-semibold text-accent hover:underline">Applicant Guides &rarr;</a>
        </div>
      </div>
      <AdSlot variant="sidebar-sticky" />
    </aside>
  </div>
</BaseLayout>
