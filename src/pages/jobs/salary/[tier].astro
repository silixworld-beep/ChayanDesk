---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JobTable from '../../../components/JobTable.astro';
import AdSlot from '../../../components/AdSlot.astro';
import {
  ALL_SALARY_TIER_META,
  type SalaryTierSlug,
} from '../../../config/site';
import {
  formatVacancies,
  getSalaryTier,
  getSalaryTierFacets,
  isJobActive,
  sortJobsByPostedDesc,
} from '../../../lib/jobs';

export async function getStaticPaths() {
  const allJobs = await getCollection('jobs');
  const slugs: SalaryTierSlug[] = [
    'up-to-25k',
    '25k-45k',
    '45k-70k',
    '70k-1l',
    'above-1l',
    'not-specified',
  ];

  return slugs.map((slug) => ({
    params: { tier: slug },
    props: {
      tierSlug: slug,
      tierMeta: ALL_SALARY_TIER_META[slug],
      jobs: sortJobsByPostedDesc(
        allJobs.filter((job) => getSalaryTier(job) === slug),
      ),
      allTierFacets: getSalaryTierFacets(allJobs),
    },
  }));
}

const { tierSlug, tierMeta, jobs, allTierFacets } = Astro.props;
const activeJobs = jobs.filter((job) => isJobActive(job));
const archivedJobs = jobs.filter((job) => !isJobActive(job));
const totalVacancies = activeJobs.reduce(
  (sum, job) => sum + (job.data.total_vacancies ?? 0),
  0,
);
---

<BaseLayout
  title={`${tierMeta.label} (${tierMeta.payLevelHint}) Government Jobs`}
  description={`${tierMeta.description} Currently ${activeJobs.length} active government openings.`}
  canonicalPath={`/jobs/salary/${tierSlug}`}
>
  <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ink-secondary">
    <ol class="flex items-center gap-1.5">
      <li><a href="/" class="hover:text-navy hover:underline">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/jobs/by-salary" class="hover:text-navy hover:underline">By Salary</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink font-medium">{tierMeta.label}</li>
    </ol>
  </nav>

  <header class="bg-surface border border-border-strong rounded-[3px] p-4 mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <div class="font-mono text-xs font-bold text-active-text uppercase">
        {tierMeta.payLevelHint}
      </div>
      <h1 class="text-xl font-bold text-navy tracking-tight mt-0.5">
        {tierMeta.label} — Government Recruitments
      </h1>
      <p class="text-xs text-ink-secondary mt-1">{tierMeta.description}</p>
    </div>
    <div class="flex flex-wrap items-center gap-2 text-xs tabular-nums shrink-0">
      <span class="px-2.5 py-1 bg-canvas border border-border rounded-[3px] text-ink">
        Active: <strong>{activeJobs.length}</strong>
      </span>
      <span class="px-2.5 py-1 bg-canvas border border-border rounded-[3px] text-ink">
        Vacancies: <strong>{formatVacancies(totalVacancies)}</strong>
      </span>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-[68fr_32fr] gap-5 items-start">
    <section aria-label="Salary Bracket Jobs" class="space-y-4">
      <JobTable
        jobs={activeJobs}
        tableId="salary-tier-active-table"
        injectInFeedAdAfterIndex={5}
        emptyMessage={`No active openings listed in the ${tierMeta.label} pay scale right now.`}
      />

      {
        archivedJobs.length > 0 && (
          <div class="space-y-2 pt-2">
            <h2 class="text-xs font-bold uppercase tracking-wider text-ink-secondary">
              Closed / Archived Notices in This Pay Scale ({archivedJobs.length})
            </h2>
            <JobTable jobs={archivedJobs} tableId="salary-tier-archived-table" />
          </div>
        )
      }
    </section>

    <aside class="space-y-4">
      <div class="bg-surface border border-border-strong rounded-[3px]">
        <div class="px-3.5 py-2.5 bg-canvas border-b border-border-strong flex items-center justify-between">
          <h2 class="text-xs font-bold uppercase tracking-wider text-navy">
            Switch Pay Scale
          </h2>
          <a href="/jobs/by-salary" class="text-xs font-medium text-accent hover:underline">
            All
          </a>
        </div>
        <ul class="divide-y divide-border">
          {
            allTierFacets.map((t) => (
              <li>
                <a
                  href={`/jobs/salary/${t.slug}`}
                  aria-current={t.slug === tierSlug ? 'page' : undefined}
                  class:list={[
                    'px-3.5 py-2.5 flex items-center justify-between text-xs no-underline',
                    t.slug === tierSlug
                      ? 'bg-active-bg font-bold text-active-text'
                      : 'text-ink hover:bg-canvas hover:text-navy',
                  ]}
                >
                  <span>
                    <span class="block font-semibold">{t.label}</span>
                    <span class="font-mono text-[10px] text-ink-secondary">{t.payLevelHint}</span>
                  </span>
                  <span class="font-mono text-[11px] tabular-nums">{t.activeCount}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <AdSlot variant="sidebar-sticky" />
    </aside>
  </div>
</BaseLayout>
