---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JobTable from '../../../components/JobTable.astro';
import AdSlot from '../../../components/AdSlot.astro';
import {
  formatVacancies,
  getSalaryTierFacets,
  isJobActive,
  sortJobsByPostedDesc,
} from '../../../lib/jobs';

const allJobs = sortJobsByPostedDesc(await getCollection('jobs'));
const activeJobs = allJobs.filter((job) => isJobActive(job));
const salaryFacets = getSalaryTierFacets(allJobs);
const highestPaid = [...activeJobs]
  .filter((j) => (j.data.salary_max ?? j.data.salary_min ?? 0) >= 45000)
  .sort(
    (a, b) =>
      (b.data.salary_max ?? b.data.salary_min ?? 0) -
      (a.data.salary_max ?? a.data.salary_min ?? 0),
  )
  .slice(0, 15);
---

<BaseLayout
  title="Government Jobs by 7th CPC Salary & Pay Matrix Scale"
  description="Browse verified Indian government and PSU jobs organized by official 7th CPC pay matrix levels and monthly salary brackets from Level 1 (up to ₹25,000) to Level 11+ (₹1 Lakh+)."
  canonicalPath="/jobs/by-salary"
>
  <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ink-secondary">
    <ol class="flex items-center gap-1.5">
      <li><a href="/" class="hover:text-navy hover:underline">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/jobs" class="hover:text-navy hover:underline">Jobs</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink font-medium">By 7th CPC Salary</li>
    </ol>
  </nav>

  <header class="bg-surface border border-border-strong rounded-[3px] p-4 mb-5">
    <h1 class="text-xl font-bold text-navy tracking-tight">
      Browse Government Jobs by 7th CPC Pay Scale &amp; Monthly Salary
    </h1>
    <p class="text-xs text-ink-secondary mt-1">
      Explore active Union, State Government, PSU, Banking, and Academic vacancies grouped strictly by notified pay matrix tiers.
    </p>
  </header>

  <section aria-label="7th CPC Salary Tiers" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 mb-6">
    {
      salaryFacets.map((tier) => (
        <a
          href={`/jobs/salary/${tier.slug}`}
          class="bg-surface border border-border-strong hover:border-active-text rounded-[3px] p-4 no-underline flex flex-col justify-between gap-3 transition-colors duration-75"
        >
          <div>
            <div class="font-mono text-[11px] font-bold text-active-text uppercase">
              {tier.payLevelHint}
            </div>
            <div class="text-base font-bold text-ink mt-1 tabular-nums">
              {tier.label}
            </div>
          </div>
          <div class="pt-2.5 border-t border-border flex items-center justify-between text-xs text-ink-secondary tabular-nums">
            <span>
              Openings: <strong class="text-navy">{tier.activeCount}</strong>
            </span>
            <span>
              Posts: <strong class="text-ink">{formatVacancies(tier.vacancies)}</strong>
            </span>
          </div>
        </a>
      ))
    }
  </section>

  <AdSlot variant="leaderboard" />

  <section aria-label="High Pay Scale Recruitment Highlights" class="mt-6 space-y-3">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-base font-bold text-navy tracking-tight">
        Top Pay Scale Active Openings (Level 6 &amp; Above / ₹45,000+ Monthly)
      </h2>
      <a href="/jobs" class="text-xs font-semibold text-accent hover:underline">
        View All {activeJobs.length} Active Jobs &rarr;
      </a>
    </div>
    <JobTable
      jobs={highestPaid}
      tableId="top-salary-jobs-table"
      emptyMessage="No specified Level 6+ openings currently listed."
    />
  </section>
</BaseLayout>
