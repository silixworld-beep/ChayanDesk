---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JobTable from '../../components/JobTable.astro';
import AdSlot from '../../components/AdSlot.astro';
import {
  formatVacancies,
  getJurisdictionSummary,
  getStateFacets,
  getStateName,
  isJobActive,
  slugify,
  sortJobsByPostedDesc,
} from '../../lib/jobs';

export async function getStaticPaths() {
  const allJobs = await getCollection('jobs');
  const facets = getStateFacets(allJobs);

  return facets.map((facet) => ({
    params: { slug: facet.slug },
    props: {
      stateName: facet.name,
      stateSlug: facet.slug,
      jobs: sortJobsByPostedDesc(
        allJobs.filter((job) => {
          const st = getStateName(job);
          return st ? slugify(st) === facet.slug : false;
        }),
      ),
      allStates: facets,
      summary: getJurisdictionSummary(allJobs),
    },
  }));
}

const { stateName, stateSlug, jobs, allStates, summary } = Astro.props;
const activeJobs = jobs.filter((job) => isJobActive(job));
const archivedJobs = jobs.filter((job) => !isJobActive(job));
const totalVacancies = activeJobs.reduce(
  (sum, job) => sum + (job.data.total_vacancies ?? 0),
  0,
);
---

<BaseLayout
  title={`${stateName} Government Jobs`}
  description={`Verified ${stateName} state government, State PSC, municipal, and public-sector job openings. Currently ${activeJobs.length} active notices covering ${formatVacancies(totalVacancies)} vacancies.`}
  canonicalPath={`/states/${stateSlug}`}
>
  <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ink-secondary">
    <ol class="flex items-center gap-1.5">
      <li><a href="/" class="hover:text-accent hover:underline">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/states" class="hover:text-accent hover:underline">State Jobs</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink font-medium">{stateName}</li>
    </ol>
  </nav>

  <header class="bg-surface border border-border-strong rounded-[3px] p-4 mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-ink tracking-tight">
        {stateName} — State Government Jobs
      </h1>
      <p class="text-xs text-ink-secondary mt-1">
        Verified state commission, municipal, health, education, and district recruitment notices in {stateName}.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2.5 text-xs tabular-nums">
      <span class="bg-canvas border border-border rounded-sm px-2.5 py-1 text-ink">
        Active Notices: <strong>{activeJobs.length}</strong>
      </span>
      <span class="bg-canvas border border-border rounded-sm px-2.5 py-1 text-ink">
        Open Vacancies: <strong>{formatVacancies(totalVacancies)}</strong>
      </span>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-10 gap-5 items-start">
    <section aria-label={`${stateName} Recruitment Table`} class="lg:col-span-7 space-y-4">
      <JobTable
        jobs={activeJobs}
        tableId="state-jobs-table"
        emptyMessage={`No active ${stateName} recruitment notices currently open.`}
      />

      {
        archivedJobs.length > 0 && (
          <div class="space-y-2 pt-2">
            <h2 class="text-xs font-bold uppercase tracking-wider text-ink-secondary">
              Expired / Archived Notices ({archivedJobs.length})
            </h2>
            <JobTable jobs={archivedJobs} tableId="archived-state-jobs-table" />
          </div>
        )
      }

      <AdSlot position="in-feed" />
    </section>

    <aside class="lg:col-span-3 space-y-4">
      <div class="bg-surface border border-border-strong rounded-[3px]">
        <div class="px-3.5 py-2.5 bg-canvas border-b border-border-strong flex items-center justify-between">
          <h2 class="text-xs font-bold uppercase tracking-wider text-ink">
            All States
          </h2>
          <a href="/central-jobs" class="text-xs font-medium text-accent hover:underline">
            Central ({summary.centralActive})
          </a>
        </div>
        <ul class="divide-y divide-border">
          {
            allStates.map((st) => (
              <li>
                <a
                  href={`/states/${st.slug}`}
                  aria-current={st.slug === stateSlug ? 'page' : undefined}
                  class:list={[
                    'px-3.5 py-2 flex items-center justify-between text-xs no-underline',
                    st.slug === stateSlug
                      ? 'bg-canvas font-semibold text-accent'
                      : 'text-ink hover:bg-canvas hover:text-accent',
                  ]}
                >
                  <span>{st.name}</span>
                  <span class="font-mono text-[11px] text-ink-secondary tabular-nums">
                    {st.activeCount}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <AdSlot position="sidebar" />
    </aside>
  </div>
</BaseLayout>
