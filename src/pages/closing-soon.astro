---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JobTable from '../components/JobTable.astro';
import AdSlot from '../components/AdSlot.astro';
import {
  isJobActive,
  isJobClosingSoon,
  sortJobsByDeadlineAsc,
} from '../lib/jobs';

const allJobs = await getCollection('jobs');
const closingIn7Days = sortJobsByDeadlineAsc(
  allJobs.filter((job) => isJobClosingSoon(job, 7)),
);
const allActiveOrderedByDeadline = sortJobsByDeadlineAsc(
  allJobs.filter((job) => isJobActive(job)),
);
const upcomingAfter7Days = allActiveOrderedByDeadline.filter(
  (job) => !isJobClosingSoon(job, 7),
);
---

<BaseLayout
  title="Closing Soon — Urgent Recruitment Deadlines"
  description="Active government job recruitments closing within the next 7 days, ordered by earliest application deadline."
  canonicalPath="/closing-soon"
>
  <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ink-secondary">
    <ol class="flex items-center gap-1.5">
      <li><a href="/" class="hover:text-accent hover:underline">Home</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink font-medium">Closing Soon</li>
    </ol>
  </nav>

  <header class="bg-surface border border-border-strong rounded-[3px] p-4 mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-ink tracking-tight">
        Closing Soon (&le; 7 Days Remaining)
      </h1>
      <p class="text-xs text-ink-secondary mt-1">
        Sorted strictly by earliest application deadline so urgent notices appear first.
      </p>
    </div>
    <span class="font-mono text-xs font-semibold text-urgent-text bg-urgent-bg border border-urgent-border rounded-sm px-2.5 py-1 tabular-nums self-start sm:self-center">
      {closingIn7Days.length} Closing Within 7 Days
    </span>
  </header>

  <div class="space-y-6">
    <section aria-label="Closing Within 7 Days" class="space-y-2.5">
      <h2 class="text-xs font-bold uppercase tracking-wider text-urgent-text">
        Immediate Priority — Next 7 Days
      </h2>
      <JobTable
        jobs={closingIn7Days}
        tableId="closing-soon-urgent-table"
        emptyMessage="No indexed recruitments are closing within the next 7 days."
      />
    </section>

    <AdSlot position="in-feed" />

    {
      upcomingAfter7Days.length > 0 && (
        <section aria-label="Upcoming Deadlines Beyond 7 Days" class="space-y-2.5">
          <h2 class="text-xs font-bold uppercase tracking-wider text-ink-secondary">
            Later Active Deadlines (Ordered Chronologically)
          </h2>
          <JobTable jobs={upcomingAfter7Days} tableId="closing-soon-later-table" />
        </section>
      )
    }
  </div>
</BaseLayout>
