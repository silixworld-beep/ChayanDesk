---
interface Props {
  slug?: string;
  shareTitle: string;
  shareMeta?: string;
  canonicalUrl: string;
  iconBookmark?: boolean;
}

const {
  slug,
  shareTitle,
  shareMeta = '',
  canonicalUrl,
  iconBookmark = false,
} = Astro.props;

const shareText = [
  shareTitle,
  shareMeta,
  `Official notice on SarkariIndex: ${canonicalUrl}`,
]
  .filter(Boolean)
  .join(' | ');

const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
---

<div class="flex flex-wrap items-center gap-2 shrink-0">
  {
    slug && iconBookmark && (
      <button
        type="button"
        data-save-slug={slug}
        data-icon-bookmark="true"
        aria-label="Bookmark exam"
        aria-pressed="false"
        title="Bookmark exam"
        class="p-1.5 bg-canvas text-ink-secondary border border-border rounded-[3px] hover:border-navy hover:text-navy transition-colors duration-75 cursor-pointer inline-flex items-center justify-center"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
        </svg>
      </button>
    )
  }
  {
    slug && !iconBookmark && (
      <button
        type="button"
        data-save-slug={slug}
        data-label-default="Save Exam"
        data-label-saved="Saved"
        aria-pressed="false"
        class="px-2.5 py-1.5 text-xs font-semibold bg-canvas text-ink-secondary border border-border rounded-[3px] hover:border-navy hover:text-navy transition-colors duration-75 cursor-pointer"
      >
        Save Exam
      </button>
    )
  }
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center px-2.5 py-1.5 text-xs font-semibold bg-active-bg text-active-text border border-active-border hover:border-active-text rounded-[3px] no-underline transition-colors duration-75"
  >
    Share &rarr;
  </a>
</div>
