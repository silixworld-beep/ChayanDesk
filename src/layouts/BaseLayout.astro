---
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';
import { SITE_CONFIG } from '../config/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(SITE_CONFIG.siteUrl);
const canonicalUrl = new URL(canonicalPath, siteOrigin).toString();
const fullTitle = title.includes(SITE_CONFIG.brandName)
  ? title
  : `${title} | ${SITE_CONFIG.brandName}`;
const currentPath = Astro.url.pathname;

function isCurrentRoute(href: string): boolean {
  if (href === '/') return currentPath === '/';
  if (href === '/jobs') {
    return (
      currentPath === '/jobs' ||
      (currentPath.startsWith('/jobs/') &&
        !currentPath.startsWith('/jobs/by-salary') &&
        !currentPath.startsWith('/jobs/salary/'))
    );
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const isSalaryRoute =
  currentPath === '/jobs/by-salary' || currentPath.startsWith('/jobs/salary/');

const adsEnabled = import.meta.env.PUBLIC_ADS_ENABLED === 'true';
const adsPreview = import.meta.env.PUBLIC_ADS_PREVIEW === 'true';
const adsActive = adsEnabled || adsPreview;
const adsenseClient = (import.meta.env.PUBLIC_ADSENSE_CLIENT ?? '').trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_CONFIG.brandName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_CONFIG.brandName} RSS Feed`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      adsEnabled && adsenseClient.startsWith('ca-pub-') && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }

    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col bg-canvas text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-surface focus:text-navy focus:px-3 focus:py-1.5 focus:border focus:border-navy focus:rounded-[3px] text-sm font-medium"
    >
      Skip to main content
    </a>

    <!-- Sticky Two-Tier Command Header -->
    <header class="sticky top-0 z-40">
      <!-- Tier 1: Official Authority Bar (32px, Sovereign Navy) -->
      <div class="bg-navy text-white h-8 border-b border-navy-hover">
        <div class="max-w-7xl mx-auto px-3 sm:px-4 h-full flex items-center justify-between gap-3 text-[11px] font-medium tracking-wide">
          <div class="truncate">
            <span class="hidden sm:inline">{SITE_CONFIG.authorityBarLeft}</span>
            <span class="sm:hidden">★ 100% GOVT &amp; PSU ONLY • DIRECT .GOV.IN LINKS</span>
          </div>
          <div class="flex items-center gap-3 shrink-0 font-mono tabular-nums">
            <span class="hidden md:inline text-white/80">{SITE_CONFIG.dailySyncLabel}</span>
            <span aria-hidden="true" class="hidden md:inline text-white/40">|</span>
            <a
              href="/saved"
              class="text-white hover:text-white/90 hover:underline no-underline flex items-center gap-1"
            >
              <span>Saved Exams</span>
              <span
                id="hdr-saved-count"
                class="inline-flex items-center justify-center min-w-[18px] h-4 px-1 bg-white/15 border border-white/25 rounded-[3px] text-[10px] font-bold tabular-nums"
              >
                0
              </span>
            </a>
          </div>
        </div>
      </div>

      <!-- Tier 2: Main Navigation Bar (60px, White Surface) -->
      <div class="bg-surface border-b border-border-strong h-[60px]">
        <div class="max-w-7xl mx-auto px-3 sm:px-4 h-full flex items-center justify-between gap-4">
          <a
            href="/"
            class="flex items-center gap-2.5 text-ink hover:text-ink no-underline shrink-0"
          >
            <span
              aria-hidden="true"
              class="w-8 h-8 bg-navy text-white rounded-[3px] flex items-center justify-center font-mono text-xs font-bold tracking-tight"
            >
              {SITE_CONFIG.shortMark}
            </span>
            <span class="flex flex-col leading-tight">
              <span class="text-base font-bold tracking-tight text-navy">
                {SITE_CONFIG.brandName}
              </span>
              <span class="font-mono text-[10px] uppercase tracking-wider text-ink-secondary hidden sm:inline">
                {SITE_CONFIG.tagline}
              </span>
            </span>
          </a>

          <nav aria-label="Primary Navigation" class="hidden md:flex items-center gap-1">
            {
              SITE_CONFIG.navLinks.map((item) => {
                const active = isCurrentRoute(item.href);
                return (
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'px-2.5 py-1.5 text-[13px] font-semibold rounded-[3px] border no-underline transition-colors duration-150 whitespace-nowrap',
                      active
                        ? 'bg-navy text-white border-navy hover:bg-navy-hover hover:text-white'
                        : 'text-ink-secondary border-transparent hover:text-navy hover:bg-canvas hover:border-border',
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })
            }
          </nav>

          <div class="flex items-center gap-2 shrink-0">
            <a
              href="/jobs/by-salary"
              aria-current={isSalaryRoute ? 'page' : undefined}
              class:list={[
                'inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-bold border rounded-[3px] no-underline transition-colors duration-150 whitespace-nowrap tabular-nums',
                isSalaryRoute
                  ? 'bg-active-text text-white border-active-text hover:bg-active-text/90 hover:text-white'
                  : 'bg-active-bg text-active-text border-active-border hover:bg-emerald-100/80 hover:text-active-text hover:border-active-text',
              ]}
            >
              <span>₹ By Salary</span>
            </a>

            <button
              id="mobile-nav-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="mobile-nav-drawer"
              class="md:hidden px-2.5 py-1.5 text-xs font-semibold text-ink bg-canvas border border-border rounded-[3px] hover:border-navy"
            >
              Menu
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Drawer (optional full vertical & trust links) -->
      <nav
        id="mobile-nav-drawer"
        aria-label="Mobile Navigation"
        class="hidden md:hidden border-b border-border-strong bg-surface px-4 py-2"
      >
        <div class="grid grid-cols-2 gap-1 text-xs font-semibold">
          {
            SITE_CONFIG.navLinks.map((item) => (
              <a
                href={item.href}
                class="py-2 px-2 text-ink hover:text-navy hover:bg-canvas rounded-[3px] no-underline"
              >
                {item.label}
              </a>
            ))
          }
          <a href="/central-jobs" class="py-2 px-2 text-ink hover:text-navy hover:bg-canvas rounded-[3px] no-underline">Central Govt</a>
          <a href="/states" class="py-2 px-2 text-ink hover:text-navy hover:bg-canvas rounded-[3px] no-underline">State-Wise Jobs</a>
          <a href="/saved" class="py-2 px-2 text-ink hover:text-navy hover:bg-canvas rounded-[3px] no-underline">Saved Exams</a>
          <a href="/guides" class="py-2 px-2 text-ink hover:text-navy hover:bg-canvas rounded-[3px] no-underline">Exam Guides</a>
        </div>
      </nav>

      <!-- Mobile Sticky Intent Strip (< 768px) -->
      <nav
        aria-label="Quick Vertical Intent"
        class="md:hidden bg-surface border-b border-border px-3 py-1.5 overflow-x-auto no-scrollbar"
      >
        <div class="flex items-center gap-1.5 whitespace-nowrap">
          {
            SITE_CONFIG.mobileIntentLinks.map((item) => {
              const active = isCurrentRoute(item.href) || (item.href === '/jobs/by-salary' && isSalaryRoute);
              return (
                <a
                  href={item.href}
                  class:list={[
                    'px-2.5 py-1 text-xs font-semibold border rounded-[3px] no-underline shrink-0',
                    active
                      ? 'bg-navy text-white border-navy'
                      : 'bg-canvas text-ink border-border',
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
        </div>
      </nav>
    </header>

    {
      adsActive ? (
        <div class="flex-1 w-full max-w-[1680px] mx-auto px-2 sm:px-4 flex items-start justify-center gap-3 2xl:gap-5">
          <div class="hidden xl:block w-[162px] shrink-0 sticky top-[108px] py-4 sm:py-5">
            <AdSlot variant="rail-left" />
          </div>

          <main id="main-content" class="flex-1 min-w-0 max-w-7xl w-full py-4 sm:py-5">
            <slot />
          </main>

          <div class="hidden xl:block w-[162px] shrink-0 sticky top-[108px] py-4 sm:py-5">
            <AdSlot variant="rail-right" />
          </div>
        </div>
      ) : (
        <main id="main-content" class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-4 py-4 sm:py-5">
          <slot />
        </main>
      )
    }

    <!-- 3-Column Authoritative Utility Footer -->
    <footer class="bg-surface border-t border-border-strong mt-10">
      <div class="max-w-7xl mx-auto px-4 py-8 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-navy mb-3">
            Browse Verticals &amp; Salary Tiers
          </h2>
          <div class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-xs">
            <a href="/jobs" class="text-ink-secondary hover:text-navy hover:underline">Latest Govt Jobs</a>
            <a href="/jobs/by-salary" class="text-active-text font-semibold hover:underline">₹ Jobs by Salary</a>
            <a href="/central-jobs" class="text-ink-secondary hover:text-navy hover:underline">Central Govt &amp; PSUs</a>
            <a href="/jobs/salary/above-1l" class="text-ink-secondary hover:text-navy hover:underline">₹1 Lakh+ Pay Scale</a>
            <a href="/states" class="text-ink-secondary hover:text-navy hover:underline">State-Wise Govt Jobs</a>
            <a href="/jobs/salary/45k-70k" class="text-ink-secondary hover:text-navy hover:underline">Level 6–8 Pay Scale</a>
            <a href="/closing-soon" class="text-ink-secondary hover:text-navy hover:underline">Closing Soon</a>
            <a href="/departments" class="text-ink-secondary hover:text-navy hover:underline">Recruiting Sectors</a>
            <a href="/admissions" class="text-ink-secondary hover:text-navy hover:underline">Admissions &amp; Entrances</a>
            <a href="/guides" class="text-ink-secondary hover:text-navy hover:underline">Exam Guides</a>
          </div>
        </div>

        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-navy mb-3">
            Resources &amp; Exam Guides
          </h2>
          <ul class="space-y-1.5 text-xs">
            <li>
              <a href="/closing-soon" class="text-ink-secondary hover:text-navy hover:underline">
                Closing Soon (&le; 7 Days Urgency Queue)
              </a>
            </li>
            <li>
              <a href="/saved" class="text-ink-secondary hover:text-navy hover:underline">
                My Saved Exams &amp; Deadlines
              </a>
            </li>
            <li>
              <a href="/departments" class="text-ink-secondary hover:text-navy hover:underline">
                Browse by Recruiting Sector
              </a>
            </li>
            <li>
              <a href="/qualifications" class="text-ink-secondary hover:text-navy hover:underline">
                Browse by Academic Qualification
              </a>
            </li>
            <li>
              <a href="/guides" class="text-ink-secondary hover:text-navy hover:underline">
                Applicant Verification &amp; 7th CPC Pay Guides
              </a>
            </li>
            <li>
              <a href="/rss.xml" class="text-ink-secondary hover:text-navy hover:underline">
                Official Notices RSS Feed
              </a>
            </li>
          </ul>
        </div>

        <div class="space-y-3">
          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-navy mb-2.5">
              Legal &amp; Verification Trust
            </h2>
            <ul class="grid grid-cols-2 gap-1.5 text-xs mb-3">
              <li><a href="/about" class="text-ink-secondary hover:text-navy hover:underline">About &amp; Verification Policy</a></li>
              <li><a href="/contact" class="text-ink-secondary hover:text-navy hover:underline">Contact &amp; Corrections</a></li>
              <li><a href="/privacy-policy" class="text-ink-secondary hover:text-navy hover:underline">Privacy Policy</a></li>
              <li><a href="/terms" class="text-ink-secondary hover:text-navy hover:underline">Terms of Use</a></li>
              <li class="col-span-2">
                <a href="/disclaimer" class="font-semibold text-urgent-text hover:underline">
                  Non-Government Independent Portal Disclaimer &rarr;
                </a>
              </li>
            </ul>
          </div>
          <p class="text-[11px] text-ink-secondary leading-relaxed border-t border-border pt-2.5">
            <strong>Not affiliated with any government agency.</strong>{' '}
            {SITE_CONFIG.brandName} ({SITE_CONFIG.positioningTagline}) indexes
            publicly issued official circulars solely for applicant reference.
          </p>
        </div>
      </div>

      <div class="border-t border-border bg-canvas">
        <div class="max-w-7xl mx-auto px-4 py-2.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-[11px] text-ink-secondary">
          <span>
            &copy; {new Date().getFullYear()} {SITE_CONFIG.brandName}. Verified
            public-sector circulars only.
          </span>
          <span class="font-mono">
            {SITE_CONFIG.positioningTagline}
          </span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        // Mobile drawer toggle
        const toggleBtn = document.getElementById('mobile-nav-toggle');
        const drawer = document.getElementById('mobile-nav-drawer');
        if (toggleBtn && drawer) {
          toggleBtn.addEventListener('click', function () {
            const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
            toggleBtn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
            drawer.classList.toggle('hidden', expanded);
          });
        }

        // Global Saved Exams Store (localStorage key: chayandesk_saved_exams)
        const STORAGE_KEY = 'chayandesk_saved_exams';
        const LEGACY_STORAGE_KEY = 'sarkari_saved_exams';
        function getSavedSlugs() {
          try {
            let raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) {
              const legacy = localStorage.getItem(LEGACY_STORAGE_KEY);
              if (legacy) {
                localStorage.setItem(STORAGE_KEY, legacy);
                raw = legacy;
              }
            }
            const parsed = JSON.parse(raw || '[]');
            return Array.isArray(parsed) ? parsed.filter((s) => typeof s === 'string') : [];
          } catch (_) {
            return [];
          }
        }
        function setSavedSlugs(list) {
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
          } catch (_) {}
        }

        function syncSavedUI() {
          const saved = getSavedSlugs();
          const hdrBadge = document.getElementById('hdr-saved-count');
          if (hdrBadge) hdrBadge.textContent = String(saved.length);

          document.querySelectorAll('[data-save-slug]').forEach((btn) => {
            const slug = btn.getAttribute('data-save-slug');
            const isSaved = slug ? saved.includes(slug) : false;
            btn.setAttribute('aria-pressed', isSaved ? 'true' : 'false');
            if (btn.hasAttribute('data-icon-bookmark')) {
              const svg = btn.querySelector('svg');
              if (svg) svg.setAttribute('fill', isSaved ? 'currentColor' : 'none');
              btn.setAttribute('aria-label', isSaved ? 'Remove bookmark' : 'Bookmark exam');
              btn.setAttribute('title', isSaved ? 'Remove bookmark' : 'Bookmark exam');
              btn.classList.toggle('bg-navy', isSaved);
              btn.classList.toggle('text-white', isSaved);
              btn.classList.toggle('border-navy', isSaved);
              btn.classList.toggle('bg-canvas', !isSaved);
              btn.classList.toggle('text-ink-secondary', !isSaved);
              btn.classList.toggle('border-border', !isSaved);
            } else {
              const lbl = btn.getAttribute('data-label-default') || 'Save';
              const savedLbl = btn.getAttribute('data-label-saved') || 'Saved';
              btn.textContent = isSaved ? savedLbl : lbl;
              btn.classList.toggle('bg-navy', isSaved);
              btn.classList.toggle('text-white', isSaved);
              btn.classList.toggle('border-navy', isSaved);
              btn.classList.toggle('bg-canvas', !isSaved);
              btn.classList.toggle('text-ink-secondary', !isSaved);
              btn.classList.toggle('border-border', !isSaved);
            }
          });

          window.dispatchEvent(new CustomEvent('chayandesk:saved-updated', { detail: { saved } }));
        }

        document.addEventListener('click', function (ev) {
          const target = ev.target instanceof Element ? ev.target.closest('[data-save-slug]') : null;
          if (!target) return;
          ev.preventDefault();
          const slug = target.getAttribute('data-save-slug');
          if (!slug) return;
          const saved = getSavedSlugs();
          const idx = saved.indexOf(slug);
          if (idx >= 0) saved.splice(idx, 1);
          else saved.unshift(slug);
          setSavedSlugs(saved);
          syncSavedUI();
        });

        window.__chayanGetSaved = getSavedSlugs;
        window.__chayanSetSaved = function (arr) {
          setSavedSlugs(arr);
          syncSavedUI();
        };
        window.__chayanSyncSaved = syncSavedUI;

        syncSavedUI();
      })();
    </script>
  </body>
</html>
