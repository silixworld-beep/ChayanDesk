# Set to "true" only after Google AdSense approval to render live <AdSlot /> containers
PUBLIC_ADS_ENABLED=false
# Set to "true" during local design preview to inspect reserved ad containers (keep false in production)
PUBLIC_ADS_PREVIEW=false
# Your Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
PUBLIC_ADSENSE_CLIENT=
# AdSense Ad Unit Slot IDs (numeric IDs from AdSense Dashboard)
PUBLIC_ADSENSE_SLOT_LEFT_RAIL=
PUBLIC_ADSENSE_SLOT_RIGHT_RAIL=
PUBLIC_ADSENSE_SLOT_LEADERBOARD=
PUBLIC_ADSENSE_SLOT_IN_FEED=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_DETAIL_MID=

# Required for scripts/fetch_jobs.py AI structured extraction
GEMINI_API_KEY=
# Optional override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional hosted dpnkrpl/jobful-api instance URL (e.g. https://your-jobful-api.vercel.app)
JOBFUL_API_URL=
